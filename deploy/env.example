# Copy to deploy/.env and edit.
# Comma-separated bearer tokens; leave empty only on a trusted network.
API_TOKENS=
# Host bind address and port for compose.
BIND=0.0.0.0
PORT=8810
# How often to ask IMDb whether the dataset files changed (they change daily).
IMDB_CHECK_INTERVAL=6h
# Optional datasets to leave out (saves disk and import time):
# akas (alternative/Chinese titles), principals (cast), crew, names (people).
IMDB_SKIP=
LOG_LEVEL=info
